{
  "name": "exportflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Internal export operations management system",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43173",
    "build": "tsc -b && vite build && node scripts/build-artifact-guard.mjs --root dist --strip-copied-vars --values .dev.vars",
    "preview": "vite preview --host 127.0.0.1 --port 43173",
    "lint": "oxlint src server worker shared tests scripts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply exportflow-local --local",
    "db:migrate:remote": "echo 'Refusing remote migration. Owner approval required. See docs/CLOUDFLARE_SETUP.md' && exit 1",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "seed:lookups": "wrangler d1 execute exportflow-local --local --file=scripts/seed-lookups.sql"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.4.18",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.9",
    "i18next": "^25.5.3",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.12",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "oxlint": "^1.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
